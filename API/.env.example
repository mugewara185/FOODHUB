PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/foodhub?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Comma-separated allowed frontend origins for CORS (e.g., local dev and Azure SWA domain)
CLIENT_URL=http://localhost:5173,https://<your-app>.azurestaticapps.net
SIMULATOR_STEP_METERS=100
SIMULATOR_INTERVAL_MS=3000

