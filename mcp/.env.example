# -------------------------------------------------------
# FoodHub MCP Server — Environment Variables
# Copy this file to .env and fill in values as needed.
# -------------------------------------------------------

# Server identity (displayed in MCP client metadata)
MCP_SERVER_NAME=foodhub-analytics
MCP_SERVER_VERSION=1.0.0

# Node environment: development | production
NODE_ENV=development

# Future: real API base URL when connecting to live data
# API_BASE_URL=http://localhost:5000
# API_SECRET_KEY=your_internal_api_key_here
