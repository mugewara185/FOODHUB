VITE_GOOGLE_MAPS_API_KEY=dummy-key-for-testing-123

# VITE_DEV_BYPASS_AUTH=false
VITE_DEV_BYPASS_AUTH=true

# VITE_DATA_SOURCE=mock
VITE_DATA_SOURCE=api

# Environment mode
MODE=development

# API base URL (can be absolute or relative)
VITE_API_URL=http://localhost:1000/api

# Data source (mock | api)
VITE_DATA_SOURCE=api

# Dev bypass auth (true only in dev)
VITE_DEV_BYPASS_AUTH=true

# Sentry DSN (leave empty if not used)
VITE_SENTRY_DSN=

# Socket URL (optional, leave empty if not used)
VITE_SOCKET_URL=

# Logger config
VITE_LOGGER_CONSOLE_ENABLED=true
VITE_LOGGER_MAX_LOGS=1000
VITE_LOGGER_PERSIST_LOGS=false
VITE_LOGGER_LEVEL=DEBUG
VITE_LOGGER_ENABLE_STACK_TRACE=false
VITE_LOGGER_ENABLE_TIMESTAMPS=false
VITE_LOGGER_RENDER_ENABLED=false
VITE_LOGGER_ROUTE_ENABLED=false
VITE_LOGGER_REDUX_ENABLED=false
VITE_LOGGER_API_ENABLED=false
