# Data Source ('api' for real backend, 'mock' for local in-memory UI development)
VITE_DATA_SOURCE=api

# API Base URL (e.g., '/api' for local proxy, 'https://foodhub-api.onrender.com/api' for production)
VITE_API_URL=http://localhost:1000/api

# Realtime Socket.IO URL (Leave empty to inherit origin from VITE_API_URL, or e.g. 'https://foodhub-api.onrender.com')
VITE_SOCKET_URL=

# Dev Auth Bypass (strictly development only; ignored in production builds)
VITE_DEV_BYPASS_AUTH=false

# Optional Maps Key
VITE_GOOGLE_MAPS_API_KEY=
